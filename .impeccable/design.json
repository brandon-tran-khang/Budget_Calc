  "components": [
    {
      "name": "Envelope Row",
      "kind": "custom",
      "refersTo": "envelope-track",
      "description": "Signature ledger line: flap chip, net bar in the category stock, hatched slip for returned money, amount.",
      "html": "<div class=\"ds-env\" style=\"--c:#E0674F\"><div class=\"ds-nm\"><i class=\"ds-chip\"></i><span>Restaurants</span></div><div class=\"ds-track\"><div class=\"ds-net\" style=\"width:62%\"></div><div class=\"ds-ret\" style=\"width:18%\"></div></div><div class=\"ds-amt\">$412.80</div><div class=\"ds-rl\">returned $96.00</div></div>",
      "css": ".ds-env{--bc-ink:#17201B;--bc-muted:rgba(23,32,27,.66);--bc-line:rgba(23,32,27,.14);--bc-track:rgba(23,32,27,.08);--bc-surface:rgba(23,32,27,.03);--bc-primary:#36805F;font-family:'Public Sans',sans-serif;font-variant-numeric:tabular-nums;display:grid;grid-template-columns:minmax(130px,190px) 1fr 96px;align-items:center;gap:4px 16px;padding:12px 0;border-top:1px solid var(--bc-line);color:var(--bc-ink)}.ds-nm{display:flex;align-items:center;gap:12px;font-weight:600;font-size:14px}.ds-chip{position:relative;width:26px;height:18px;border-radius:2px;background:var(--c);flex:none}.ds-chip:before{content:'';position:absolute;left:0;top:0;border:13px solid transparent;border-top:9px solid rgba(0,0,0,.18);border-bottom:0}.ds-track{height:14px;background:var(--bc-track);border-radius:3px;overflow:hidden;display:flex}.ds-net{background:var(--c);transform-origin:left;animation:ds-draw 420ms cubic-bezier(.16,1,.3,1) both}.ds-ret{opacity:.7;transform-origin:left;background:repeating-linear-gradient(135deg,var(--c) 0 2px,transparent 2px 6px);animation:ds-draw 420ms cubic-bezier(.16,1,.3,1) both}@keyframes ds-draw{from{transform:scaleX(0)}}.ds-amt{text-align:right;font-weight:600;font-size:14px}.ds-rl{grid-column:2;font-size:12px;color:var(--bc-primary)}@media (prefers-reduced-motion:reduce){.ds-net,.ds-ret{animation:none}}"
    },
    {
      "name": "Envelope Chip",
      "kind": "chip",
      "refersTo": "envelope-chip",
      "description": "Category stock block with a darker triangular flap; the category's identity everywhere.",
      "html": "<i class=\"ds-chip\" style=\"--c:#D9A21B\"></i>",
      "css": ".ds-chip{position:relative;display:inline-block;width:26px;height:18px;border-radius:2px;background:var(--c)}.ds-chip:before{content:'';position:absolute;left:0;top:0;border:13px solid transparent;border-top:9px solid rgba(0,0,0,.18);border-bottom:0}"
    },
    {
      "name": "Hero Figure",
      "kind": "custom",
      "refersTo": "hero-figure",
      "description": "The one display-size out-of-pocket figure with its period inline and the breakdown below.",
      "html": "<section class=\"ds-hero\"><div class=\"ds-big\">$3,284.17<small>out of pocket · March 2026</small></div><div class=\"ds-brk\">Gross <b>$3,612.40</b> · Refunds <b>−$128.23</b> · Reimbursed <b>−$200.00</b></div></section>",
      "css": ".ds-hero{--bc-ink:#17201B;--bc-muted:rgba(23,32,27,.66);--bc-line:rgba(23,32,27,.14);--bc-track:rgba(23,32,27,.08);--bc-surface:rgba(23,32,27,.03);--bc-primary:#36805F;font-family:'Public Sans',sans-serif;font-variant-numeric:tabular-nums;color:var(--bc-ink)}.ds-big{font-size:clamp(56px,8vw,96px);font-weight:800;line-height:1;letter-spacing:-.03em}.ds-big small{font-size:15px;font-weight:600;letter-spacing:0;margin-left:12px;color:var(--bc-muted)}.ds-brk{padding:10px 0;color:var(--bc-muted);line-height:1.7;font-size:14px}.ds-brk b{color:var(--bc-ink);font-weight:600}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "rail-nav-item-active",
      "description": "Green rail with uppercase group headers and a paper pill for the active page.",
      "html": "<nav class=\"ds-rail\"><div class=\"ds-brand\">Budget Calc</div><header>Review</header><a aria-current=\"page\" href=\"#\">Overview</a><a href=\"#\">Vendors</a><header>Clean up</header><a href=\"#\">Transactions</a></nav>",
      "css": ".ds-rail{font-family:'Public Sans',sans-serif;background:#1F4D3A;color:#E4EFE8;padding:16px;width:240px;display:flex;flex-direction:column;gap:4px}.ds-brand{font-weight:800;font-size:18px;letter-spacing:-.01em;padding-left:22px;background:linear-gradient(#D9A21B,#D9A21B) left center/14px 10px no-repeat;margin-bottom:12px}.ds-rail header{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;opacity:.7;margin-top:12px}.ds-rail a{color:inherit;text-decoration:none;border-radius:6px;padding:2px 10px;font-size:14px;transition:background-color 150ms,color 150ms}.ds-rail a:hover{background:rgba(255,255,255,.08)}.ds-rail a[aria-current=page]{background:#F4F6F2;color:#1F4D3A;font-weight:600}.ds-rail a:focus-visible{outline:2px solid #5BAE8C;outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Save or confirm on a cleanup form; Ledger Green fill with an icon.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M17 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7l-4-4zm-5 16a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm3-10H5V5h10v4z\"/></svg>Save changes</button>",
      "css": ".ds-btn-primary{font-family:'Public Sans',sans-serif;display:inline-flex;align-items:center;gap:8px;background:#1F6B4F;color:#fff;border:1px solid #1F6B4F;border-radius:6px;padding:6px 12px;font-size:14px;cursor:pointer;transition:background-color 150ms,border-color 150ms}.ds-btn-primary:hover{background:#17402F;border-color:#17402F}.ds-btn-primary:focus-visible{outline:2px solid #36805F;outline-offset:2px}"
    },
    {
      "name": "Metric",
      "kind": "custom",
      "refersTo": "metric-value",
      "description": "Bare metric: muted label over a 26px value, no card.",
      "html": "<div class=\"ds-metric\"><div class=\"ds-ml\">Transactions</div><div class=\"ds-mv\">142</div></div>",
      "css": ".ds-metric{--bc-ink:#17201B;--bc-muted:rgba(23,32,27,.66);--bc-line:rgba(23,32,27,.14);--bc-track:rgba(23,32,27,.08);--bc-surface:rgba(23,32,27,.03);--bc-primary:#36805F;font-family:'Public Sans',sans-serif;font-variant-numeric:tabular-nums;color:var(--bc-ink)}.ds-ml{color:var(--bc-muted);font-size:13px;font-weight:600}.ds-mv{font-size:26px;font-weight:600;letter-spacing:-.01em}"
    },
    {
      "name": "Receipts Panel",
      "kind": "card",
      "refersTo": "receipts-panel",
